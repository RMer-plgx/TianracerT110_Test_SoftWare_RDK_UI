+// ---- 通讯录音：被动旁听，绝不改变转发路径 ----
+// 只写普通文件。写失败就把该方向关掉，收发一个字节都不受影响。
+static void tap_dump(int *fd, long *written, long limit,
+                     const uint8_t *data, int len)
+{
+    if (*fd < 0 || len <= 0)
+    {
+        return;
+    }
+    if (*written + (long)len > limit)
+    {
+        // 到上限：停止录音，继续转发
+        ::close(*fd);
+        *fd = -1;
+        return;
+    }
+    ssize_t n = ::write(*fd, data, (size_t)len);
+    if (n != (ssize_t)len)
+    {
+        // 磁盘满 / 权限问题：关掉录音，绝不影响通信
+        ::close(*fd);
+        *fd = -1;
+        return;
+    }
+    *written += (long)len;
+}
